# Spring Boot profile
SPRING_PROFILES_ACTIVE=dev

# MySQL development database
DB_URL=jdbc:mysql://localhost:3306/league_ticket?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-password

# JWT (use at least 32 random bytes; never commit a real secret)
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=120

# Local avatar storage for course-project demonstrations
APP_UPLOAD_DIR=./uploads

# One-time demo password initialization
DEMO_PASSWORD_INIT_ENABLED=false
DEMO_PASSWORD=replace-with-a-local-demo-password
